# ==============================================================================
# SISTEM ABSENSI MAHASISWA BERBASIS WEB DENGAN AI - STMIK IKMI CIREBON
# Environment Configuration Template
# ==============================================================================

# Application Setting
APP_NAME="Absensi Mahasiswa AI - STMIK IKMI Cirebon"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/absensi_mahasiswa/public
APP_TIMEZONE=Asia/Jakarta

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_absensi_ikmi
DB_USER=root
DB_PASS=

# Session & Security
SESSION_LIFETIME=7200
CSRF_PROTECTION=true
APP_KEY=base64:ikmi_attendance_secret_key_random2026_xyz123

# Campus Location & Geofence (STMIK IKMI Cirebon)
# Alamat: Jl. Perjuangan No.10B, Karyamulya, Kec. Kesambi, Kota Cirebon, Jawa Barat 45131
CAMPUS_NAME="STMIK IKMI Cirebon"
CAMPUS_LATITUDE=-6.7441584
CAMPUS_LONGITUDE=108.5441566
CAMPUS_RADIUS_METERS=100

# Face AI Configuration
FACE_SIMILARITY_THRESHOLD=0.55
FACE_MODEL_PATH=/models

# File Upload Max Size (in KB)
MAX_UPLOAD_SIZE=5120

# Google Gemini Chatbot Configuration
# Nilai ini menjadi fallback bila API key belum disimpan melalui menu Konfigurasi Admin.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
