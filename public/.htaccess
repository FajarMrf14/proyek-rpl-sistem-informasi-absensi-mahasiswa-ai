<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /absensi_mahasiswa/public/

    # Cegah akses langsung ke file tersembunyi
    RewriteRule ^\.(.*)$ - [F]

    # Jangan rewrite jika file atau folder fisik memang ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan semua request ke index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Keamanan direktori
Options -Indexes
